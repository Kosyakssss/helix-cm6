{
  "name": "helix-cm6",
  "version": "0.0.0",
  "private": true,
  "description": "Helix for CodeMirror 6: a port of Helix, checked against real Helix",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./regex.wasm": "./regex/regex.wasm",
    "./tree-sitter.wasm": "./tree-sitter/tree-sitter.wasm",
    "./test/harness": "./test/harness.ts",
    "./test/oracle": "./test/oracle/oracle.ts",
    "./test/suites": "./test/oracle/suites.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "regex/regex.wasm",
    "regex/NOTICE",
    "tree-sitter/tree-sitter.wasm",
    "tree-sitter/NOTICE",
    "test/harness.ts",
    "test/oracle",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build.ts",
    "check": "tsc --noEmit -p .",
    "test": "bun test",
    "diff": "bun test/oracle/diff.ts",
    "browser": "bun test/browser/differential.ts",
    "views": "bun test/browser/views.ts",
    "play": "bun play/server.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.3",
    "eslint": "10.13.0",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
